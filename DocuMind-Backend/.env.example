# ---- existing ----
PORT=5000
MONGO_URI=your-mongodb-connection-string
# REQUIRED: at least 32 characters, random. The server refuses to start without it. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-generate-a-long-random-secret
CLIENT_ORIGIN=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-client-GOOGLE_CLIENT_ID

# ---- security (all optional, defaults shown) ----
# Set to "production" when deployed: Secure cookies + HSTS.
NODE_ENV=development
# Behind a proxy/host (Render, Railway, Nginx...) set to the number of proxies (usually 1)
# so rate limits and the audit log see the real client IP.
# TRUST_PROXY=1
# Session cookie SameSite: lax | strict | none. Production default is "none" (front end and API on different sites).
# Use "lax" or "strict" if both are on the same site.
# COOKIE_SAMESITE=lax
# Lock an account after this many wrong passwords, for this many minutes.
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# Whole-API limit per IP per minute, and uploads/AI generations allowed per user per hour.
API_RATE_LIMIT_PER_MIN=600
MAX_GENERATIONS_PER_HOUR=20
# Several front-end origins (comma separated) may be listed in CLIENT_ORIGIN.

# ---- email (verification + password reset) ----
# Run `npm install` once (nodemailer is a dependency). Without SMTP_HOST the emails are only
# printed in the backend terminal: fine for development, NOT for production.
# Gmail: use an App Password (Google account > Security > 2-Step Verification > App passwords).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-address@gmail.com
# SMTP_PASS=your-app-password
# EMAIL_FROM="DocuMind <your-address@gmail.com>"
# Public URL of the front end, used for the links inside emails (defaults to the first CLIENT_ORIGIN).
# CLIENT_URL=http://localhost:5173
# Set to "false" to let people sign in without confirming their email address.
# REQUIRE_EMAIL_VERIFICATION=true
# How long a password-reset link stays valid (minutes).
# PASSWORD_RESET_MINUTES=30

# ---- AI (new) ----
# Create at https://platform.openai.com/api-keys  (keep it secret, never commit it)
OPENAI_API_KEY=sk-your-key-here

# Models (defaults shown)
STT_MODEL=gpt-transcribe
LLM_MODEL=gpt-6-luna
# Model for the "Generate code" page. Leave it out to use LLM_MODEL (gpt-6-luna).
# CODE_MODEL=gpt-6-luna
# Model for the "Generate diagram" page. Leave it out to use LLM_MODEL (gpt-6-luna).
# DIAGRAM_MODEL=gpt-6-luna
# Leave empty for the model default. "low" = faster and cheaper summaries.
LLM_REASONING_EFFORT=

# Audio is cut into pieces of this length (seconds) before transcription
CHUNK_SECONDS=300
# Neighbouring audio pieces overlap by this many seconds (no word is lost at a cut; duplicates are removed again)
CHUNK_OVERLAP_SECONDS=8
# How many audio pieces are transcribed at the same time
STT_CONCURRENCY=4
# Reject recordings longer than this (minutes)
MAX_DURATION_MIN=240

# Budget protection
MAX_CONCURRENT_JOBS=2
MAX_ACTIVE_JOBS_PER_USER=2

# Only used for the cost ESTIMATES in the admin dashboard (USD)
PRICE_STT_PER_MIN=0.0045
PRICE_LLM_INPUT_PER_M=0.10
PRICE_LLM_OUTPUT_PER_M=0.50
